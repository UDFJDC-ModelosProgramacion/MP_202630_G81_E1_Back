    {
      "name": "Preparar refugio de prueba",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var data = pm.response.json();",
              "pm.expect(data.id, \"El refugio debe incluir el id creado\").to.exist;",
              "pm.collectionVariables.set(\"solicitud_refugio_id\", data.id);",
              "pm.globals.set(\"solicitud_refugio_id\", data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Refugio Solicitud {{$guid}}\",\n  \"ciudad\": \"Bogota\",\n  \"direccion\": \"Calle 1 # 2-3\",\n  \"telefono\": \"3001234567\",\n  \"email\": \"solicitud.refugio.{{$guid}}@example.com\",\n  \"descripcion\": \"Refugio creado por la colección de solicitudes\",\n  \"fechaRegistro\": \"2026-10-04\"\n}",
          "options": {
            "raw": {
