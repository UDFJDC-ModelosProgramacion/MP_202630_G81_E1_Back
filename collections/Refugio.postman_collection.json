    {
      "name": "Setup",
      "item": [
        {
          "name": "Setup: crear refugio para prueba de borrado con mascotas",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/refugios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "refugios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Refugio Setup Mascotas {{$timestamp}}\",\n  \"ciudad\": \"Bogota\",\n  \"direccion\": \"Calle 1 # 2-3\",\n  \"telefono\": \"3001234567\",\n  \"email\": \"refugio@correo.com\",\n  \"descripcion\": \"Refugio de prueba\",\n  \"fechaRegistro\": \"2026-01-10\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var data = pm.response.json();",
                  "pm.globals.set(\"refugio_setup_id\", data.id);",
                  "pm.test(\"Status code is 201\", function () {",
                  "   pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
