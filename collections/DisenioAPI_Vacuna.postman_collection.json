          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Antirrabica\",\n  \"descripcion\": \"Vacuna anual contra la rabia\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/vacunas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "vacunas"
          ]
        },
