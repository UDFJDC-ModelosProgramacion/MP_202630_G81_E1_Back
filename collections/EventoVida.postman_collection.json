						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/mascotas/{{mascotaId}}/eventos-vida?tipo={{tipoEvento}}&fechaInicio={{fechaInicio}}",
					"host": ["{{baseUrl}}"],
					"path": ["mascotas", "{{mascotaId}}", "eventos-vida"],
					"query": [
						{
							"key": "tipo",
							"value": "{{tipoEvento}}",
							"description": "Tipo de evento: Nacimiento, Vacunación, Enfermedad, Adopción, Muerte"
						},
						{
							"key": "fechaInicio",
							"value": "{{fechaInicio}}",
							"description": "Fecha de inicio en formato YYYY-MM-DD"
						}
					]
				},
				"description": "Obtiene eventos de vida de una mascota filtrados por tipo a partir de una fecha específica."
			},
			"response": [{"name":"Respuesta 200 OK","status":"OK","code":200,"body":"[]"}]
		},
		{
			"name": "Crear Evento de Vida",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 or 200\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"});",
							"pm.test(\"Evento creado correctamente\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"tipo\": \"Vacunación\",\n    \"fecha\": \"2024-01-15\",\n    \"descripcion\": \"Vacuna antirrábica anual\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/mascotas/{{mascotaId}}/eventos-vida",
					"host": ["{{baseUrl}}"],
					"path": ["mascotas", "{{mascotaId}}", "eventos-vida"]
				},
				"description": "Crea un nuevo evento de vida para una mascota. Tipos válidos: Nacimiento, Vacunación, Enfermedad, Adopción, Muerte. La fecha no puede ser futura."
			},
			"response": [{"name":"Respuesta 201 Created","status":"Created","code":201,"body":"{\"id\":1,\"tipo\":\"Vacunación\",\"fecha\":\"2024-01-15\",\"descripcion\":\"Vacuna antirrábica anual\"}"}]
		},
		{
			"name": "Actualizar Evento de Vida",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Evento actualizado correctamente\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"id\": {{eventoVidaId}},\n    \"tipo\": \"Enfermedad\",\n    \"fecha\": \"2024-02-10\",\n    \"descripcion\": \"Infección leve tratada con antibióticos\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/mascotas/{{mascotaId}}/eventos-vida/{{eventoVidaId}}",
					"host": ["{{baseUrl}}"],
					"path": ["mascotas", "{{mascotaId}}", "eventos-vida", "{{eventoVidaId}}"]
				},
				"description": "Actualiza un evento de vida existente. La fecha no puede ser futura y el tipo debe ser válido."
			},
			"response": [{"name":"Respuesta 200 OK","status":"OK","code":200,"body":"{\"id\":1,\"tipo\":\"Enfermedad\",\"fecha\":\"2024-02-10\",\"descripcion\":\"Infección leve tratada\"}"}]
		},
