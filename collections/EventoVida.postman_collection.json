{
	"info": {
		"_postman_id": "eventovida-collection-001",
		"name": "EventoVida",
		"description": "Colección de endpoints para la gestión de eventos de vida de mascotas. Permite crear, consultar, actualizar y eliminar eventos de vida (Nacimiento, Vacunación, Enfermedad, Adopción, Muerte).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Obtener Eventos de Vida por Mascota",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Response is an array\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"});"
						],
						"type": "text/javascript"
					}
				}
		],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/mascotas/{{mascotaId}}/eventos-vida",
					"host": ["{{baseUrl}}"],
					"path": ["mascotas", "{{mascotaId}}", "eventos-vida"]
				},
				"description": "Obtiene todos los eventos de vida de una mascota específica."
			},
			"response": [{"name":"Respuesta 200 OK","status":"OK","code":200,"body":"[]"}]
		},
		{
			"name": "Obtener Eventos de Vida por Tipo",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Response is an array\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/mascotas/{{mascotaId}}/eventos-vida?tipo={{tipoEvento}}",
					"host": ["{{baseUrl}}"],
					"path": ["mascotas", "{{mascotaId}}", "eventos-vida"],
					"query": [
						{
							"key": "tipo",
							"value": "{{tipoEvento}}",
							"description": "Tipo de evento: Nacimiento, Vacunación, Enfermedad, Adopción, Muerte"
						}
					]
				},
				"description": "Obtiene eventos de vida de una mascota filtrados por tipo. Tipos válidos: Nacimiento, Vacunación, Enfermedad, Adopción, Muerte."
			},
			"response": [{"name":"Respuesta 200 OK","status":"OK","code":200,"body":"[]"}]
		},
		{
			"name": "Obtener Eventos de Vida por Tipo y Rango de Fechas",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Response is an array\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"});"
