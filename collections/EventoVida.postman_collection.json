				"url": {
					"raw": "{{baseUrl}}/mascotas/{{mascotaId}}/eventos-vida?tipo={{tipoEvento}}&fechaInicio={{fechaInicio}}&fechaFin={{fechaFin}}",
					"host": ["{{baseUrl}}"],
					"path": ["mascotas", "{{mascotaId}}", "eventos-vida"],
					"query": [
						{
							"key": "tipo",
							"value": "{{tipoEvento}}",
							"description": "Tipo de evento: Nacimiento, Vacunación, Enfermedad, Adopción, Muerte"
						},
						{
							"key": "fechaInicio",
							"value": "{{fechaInicio}}",
							"description": "Fecha de inicio en formato YYYY-MM-DD"
						},
						{
							"key": "fechaFin",
							"value": "{{fechaFin}}",
							"description": "Fecha de fin en formato YYYY-MM-DD"
						}
					]
				},
				"description": "Obtiene eventos de vida de una mascota filtrados por tipo y rango de fechas."
			},
			"response": [{"name":"Respuesta 200 OK","status":"OK","code":200,"body":"[]"}]
		},
