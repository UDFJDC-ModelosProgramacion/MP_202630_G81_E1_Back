					"request": {"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/mascotas/{{mascotaId}}/eventos-vida/{{eventoVidaId}}","host":["{{baseUrl}}"],"path":["mascotas","{{mascotaId}}","eventos-vida","{{eventoVidaId}}"]}},
			"response":[{"name":"Respuesta 200 OK","status":"OK","code":200,"body":"{\"id\":1,\"tipo\":\"Vacunación\",\"fecha\":\"2024-01-15\",\"descripcion\":\"Vacuna antirrábica anual\"}"}]
