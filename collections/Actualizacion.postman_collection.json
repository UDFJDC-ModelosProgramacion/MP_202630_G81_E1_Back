    {
      "name": "Crear actualizacion",
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
        "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
        "var data = pm.response.json();",
        "pm.expect(data.id, \"La respuesta debe incluir el id creado\").to.exist;",
        "pm.collectionVariables.set(\"actualizacionId\", data.id);",
        "pm.globals.set(\"actualizacionId\", data.id);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fecha\": \"2026-09-30\",\n  \"tipo\": \"MEDICA\",\n  \"descripcion\": \"Se aplico desparasitante\",\n  \"archivoUrl\": \"https://example.com/archivo.pdf\",\n  \"mascota\": { \"id\": {{mascotaId}} },\n  \"adoptante\": { \"id\": {{adoptanteId}} }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/actualizaciones", "host": ["{{baseUrl}}"], "path": ["actualizaciones"] }
      },
      "response": []
    },
