            "description": "200 OK -> AdoptanteDTODetail (agrega mensajes y, cuando exista SolicitudAdopcionDTO, solicitudesAdopcion).\n404 Not Found si el id no existe."
          },
          "response": []
        },
        {
          "name": "Crear adoptante",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Laura Gomez\",\n  \"telefono\": \"3001234567\",\n  \"email\": \"laura.gomez@example.com\",\n  \"direccion\": \"Cra 10 # 20-30\",\n  \"ciudad\": \"Bogota\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/adoptantes", "host": ["{{baseUrl}}"], "path": ["adoptantes"] },
