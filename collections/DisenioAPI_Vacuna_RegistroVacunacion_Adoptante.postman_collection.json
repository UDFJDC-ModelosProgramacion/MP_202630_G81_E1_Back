            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Laura Gomez\",\n  \"telefono\": \"3009876543\",\n  \"email\": \"laura.gomez@example.com\",\n  \"direccion\": \"Cra 10 # 20-30\",\n  \"ciudad\": \"Bogota\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/adoptantes/{{adoptanteId}}", "host": ["{{baseUrl}}"], "path": ["adoptantes", "{{adoptanteId}}"] },
