    {
      "name": "Crear resena",
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
        "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
        "var data = pm.response.json();",
        "pm.expect(data.id, \"La respuesta debe incluir el id creado\").to.exist;",
        "pm.collectionVariables.set(\"resenaId\", data.id);",
        "pm.globals.set(\"resenaId\", data.id);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"calificacion\": 5,\n  \"comentario\": \"Excelente experiencia de adopcion\",\n  \"fecha\": \"2026-09-30\",\n  \"mascota\": { \"id\": {{mascotaId}} },\n  \"adoptante\": { \"id\": {{adoptanteId}} }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/resenas", "host": ["{{baseUrl}}"], "path": ["resenas"] }
      },
      "response": []
    },
