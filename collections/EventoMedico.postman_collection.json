          "mode": "raw",
          "raw": "{\n  \"fecha\": \"2026-09-30\",\n  \"descripcion\": \"Control general\",\n  \"diagnostico\": \"Sano\",\n  \"tratamiento\": \"Ninguno\",\n  \"mascota\": { \"id\": {{mascotaId}} }\n}",
