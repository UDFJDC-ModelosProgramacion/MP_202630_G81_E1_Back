{
	"info": {
		"_postman_id": "fotografia-collection-001",
		"name": "Fotografia",
		"description": "Colección de endpoints para la gestión de fotografías de mascotas. Permite obtener, activar y eliminar fotografías asociadas a una mascota.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Preparar mascota para fotografias",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
							"if (pm.response.code === 201) {",
							"  var jsonData = pm.response.json();",
							"  if (jsonData && jsonData.id) pm.collectionVariables.set(\"mascotaId\", jsonData.id.toString());",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/mascotas",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"mascotas"
					]
				},
				"body": {
					"mode": "raw",
					"raw": "{\n  \"nombre\": \"Luna Fotografia\",\n  \"especie\": \"Perro\",\n  \"edad\": 2,\n  \"sexo\": \"Hembra\",\n  \"estado\": \"Disponible\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				}
			},
			"response": [
				{
					"name": "Respuesta 201 Created",
					"status": "Created",
					"code": 201,
					"body": "{\"id\":1,\"nombre\":\"Luna Fotografia\",\"especie\":\"Perro\"}"
				}
			]
		},
		{
			"name": "Crear Fotografia",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
							"if (pm.response.code === 201) {",
							"  var jsonData = pm.response.json();",
							"  if (jsonData && jsonData.id) pm.collectionVariables.set(\"fotografiaId\", jsonData.id.toString());",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/mascotas/{{mascotaId}}/fotografias",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"mascotas",
						"{{mascotaId}}",
						"fotografias"
					]
				},
				"body": {
					"mode": "raw",
					"raw": "{\n  \"url\": \"https://example.com/foto.jpg\",\n  \"principal\": true,\n  \"descripcion\": \"Foto principal\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				}
			},
			"response": [
				{
					"name": "Respuesta 201 Created",
					"status": "Created",
					"code": 201,
					"body": "{\"id\":1,\"url\":\"https://example.com/foto.jpg\",\"principal\":true}"
				}
			]
		},
		{
			"name": "Obtener Fotografia por ID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
							"pm.test(\"Response has fotografia data\", function () {",
							"  var jsonData = pm.response.json();",
							"  pm.expect(jsonData).to.have.property(\"id\");",
							"  pm.expect(jsonData).to.have.property(\"url\");",
							"  pm.expect(jsonData).to.have.property(\"descripcion\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/mascotas/{{mascotaId}}/fotografias/{{fotografiaId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"mascotas",
						"{{mascotaId}}",
						"fotografias",
						"{{fotografiaId}}"
					]
				}
			},
			"response": [
				{
					"name": "Respuesta 200 OK",
					"status": "OK",
					"code": 200,
					"body": "{\"id\":1,\"url\":\"https://example.com/foto.jpg\",\"principal\":true,\"descripcion\":\"Foto principal\"}"
				}
			]
		},
