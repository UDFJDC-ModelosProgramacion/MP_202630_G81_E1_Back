							"pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
							"pm.test(\"Fotografia actualizada\", function () { pm.expect(pm.response.json().descripcion).to.eql(\"Foto actualizada\"); });"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/mascotas/{{mascotaId}}/fotografias/{{fotografiaId}}",
