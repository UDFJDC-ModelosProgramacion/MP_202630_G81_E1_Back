  "item": [
    {
      "name": "Crear un refugio",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var data = pm.response.json();",
              "pm.globals.set(\"refugio_id_1\", data.id);",
              "pm.globals.set(\"refugio_nombre_1\", data.nombre);",
              "pm.test(\"Status code is 201\", function () {",
              "   pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Refugio Esperanza {{$timestamp}}\",\n  \"ciudad\": \"Bogota\",\n  \"direccion\": \"Calle 1 # 2-3\",\n  \"telefono\": \"3001234567\",\n  \"email\": \"refugio@correo.com\",\n  \"descripcion\": \"Refugio de prueba\",\n  \"fechaRegistro\": \"2026-01-10\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/refugios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "refugios"
          ]
        }
      },
      "response": []
