    {
      "name": "Crear notificacion",
      "event": [{"listen":"test","script":{"type":"text/javascript","exec":[
        "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
        "var data = pm.response.json();",
        "pm.expect(data.id, \"La respuesta debe incluir el id creado\").to.exist;",
        "pm.collectionVariables.set(\"notificacionId\", data.id);",
        "pm.globals.set(\"notificacionId\", data.id);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo\": \"RECORDATORIO\",\n  \"mensaje\": \"Su cita de seguimiento es manana\",\n  \"fecha\": \"2026-09-30\",\n  \"canal\": \"EMAIL\",\n  \"mascota\": { \"id\": {{mascotaId}} },\n  \"adoptante\": { \"id\": {{adoptanteId}} }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/notificaciones", "host": ["{{baseUrl}}"], "path": ["notificaciones"] }
      },
      "response": []
    },
